[Unit]
Description=Agente shinyd (diagnóstico somente leitura)
Requires=shinyd-agent.socket
After=shinyd-agent.socket
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/libexec/shinyd/shinyd-agent
User=root
Group=root
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
Slice=shinyd-control.slice
CPUWeight=100
MemoryHigh=96M
MemoryMax=128M
TasksMax=64
LimitNOFILE=256
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
InaccessiblePaths=-/etc/shinyd -/var/lib/shinyd/control -/var/lib/shinyd/keys
StandardOutput=journal
StandardError=journal
SyslogIdentifier=shinyd-agent
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200
