[Unit]
Description=Entrada HTTPS do shinyd
PartOf=shinyd.target
Requires=shinyd-panel.socket shinyd-gateway.socket
After=shinyd-panel.socket shinyd-gateway.socket network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
User=shinyd-ingress
Group=shinyd-ingress
ExecStart=/usr/bin/caddy run --config /etc/shinyd-tls/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
Slice=shinyd-control.slice
MemoryHigh=128M
MemoryMax=256M
TasksMax=128
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=null
StandardError=journal
