[Unit]
Description=Serviço maintenance do shinyd
PartOf=shinyd.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=oneshot
User=shinyd-control
Group=shinyd-control
ExecStart=/usr/bin/python3 -I /usr/lib/shinyd-control/launch.py maintenance
UMask=0077
Restart=no
RestartSec=5
TimeoutStopSec=75
Slice=shinyd-control.slice
MemoryHigh=256M
MemoryMax=384M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/shinyd-control
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
