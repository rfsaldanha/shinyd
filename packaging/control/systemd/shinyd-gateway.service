[Unit]
Description=Serviço gateway do shinyd
PartOf=shinyd.target
Requires=shinyd-gateway.socket
After=shinyd-gateway.socket
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=exec
User=shinyd-gateway
Group=shinyd-gateway
ExecStart=/usr/bin/python3 -I /usr/lib/shinyd-control/launch.py gateway
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
Slice=shinyd-control.slice
MemoryHigh=256M
MemoryMax=384M
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict

ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
